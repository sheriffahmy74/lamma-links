{
  "name": "lamma-social-links",
  "version": "1.0.0",
  "private": true,
  "description": "Lamma — official social links page, opened via QR code.",
  "type": "module",
  "scripts": {
    "dev": "npm run build && serve dist -l 5173",
    "build": "node scripts/build.mjs",
    "qr": "node scripts/make-qr.mjs",
    "preview": "serve dist -l 4173",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,html,json,md}\"",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.4",
    "serve": "^14.2.5"
  },
  "engines": {
    "node": ">=20"
  }
}
